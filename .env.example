# Database connection string for PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# NextAuth secret for signing tokens
NEXTAUTH_SECRET="your-nextauth-secret"

# NextAuth URL (set to deployed domain in production)
NEXTAUTH_URL="http://localhost:3000"

# Public base path for GitHub Pages deployments (leave empty for local dev)
NEXT_PUBLIC_BASE_PATH="/successblueprintcoach.com"
